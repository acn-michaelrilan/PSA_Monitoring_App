<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="aiResolutionFeedbackDialog"
        title="{i18n>feedbackDialogTitle}"
        contentWidth="520px"
        contentHeight="auto"
        resizable="true"
        draggable="true">

        <content>
            <VBox id="feedbackFormBox" class="sapUiSmallMargin">

                <!-- Title (read-only) -->
                <Label id="feedbackTitleLabel"
                    text="{i18n>feedbackCheckpointLabel}"
                    labelFor="feedbackTitleInput"/>
                <Input id="feedbackTitleInput"
                    value="{feedback>/title}"
                    editable="false"
                    width="100%"/>

                <!-- Root Cause -->
                <Label id="feedbackRootCauseLabel"
                    text="{i18n>feedbackRootCauseLabel}"
                    required="true"
                    labelFor="feedbackRootCauseInput"
                    class="sapUiSmallMarginTop"/>
                <TextArea id="feedbackRootCauseInput"
                    value="{feedback>/rootCause}"
                    maxLength="200"
                    showExceededText="true"
                    rows="3"
                    growing="true"
                    growingMaxLines="5"
                    width="100%"
                    placeholder="{i18n>feedbackRootCausePlaceholder}"/>

                <!-- Resolution -->
                <Label id="feedbackResolutionLabel"
                    text="{i18n>feedbackResolutionLabel}"
                    required="true"
                    labelFor="feedbackResolutionInput"
                    class="sapUiSmallMarginTop"/>
                <TextArea id="feedbackResolutionInput"
                    value="{feedback>/resolution}"
                    maxLength="600"
                    showExceededText="true"
                    rows="6"
                    growing="true"
                    growingMaxLines="10"
                    width="100%"
                    placeholder="{i18n>feedbackResolutionPlaceholder}"/>

            </VBox>
        </content>

        <beginButton>
            <Button id="feedbackSubmitBtn"
                text="{i18n>feedbackSaveButton}"
                type="Emphasized"
                icon="sap-icon://save"
                enabled="{= !!${feedback>/rootCause} &amp;&amp; !!${feedback>/resolution} }"
                press=".onAIResolutionFeedbackSubmit"/>
        </beginButton>

        <endButton>
            <Button id="feedbackCancelBtn"
                text="{i18n>feedbackCancelButton}"
                press=".onAIResolutionFeedbackCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>