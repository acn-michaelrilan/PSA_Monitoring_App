
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox
        id="shippedConsigneeBolWrapper"
        width="100%">

        <HBox
            id="shippedConsigneeBolFilterBar"
            alignItems="End"
            wrap="Wrap"
            class="sapUiSmallMarginBottom">

            <VBox
                id="shippedConsigneeBolMatchedFilterBox"
                class="sapUiSmallMarginEnd">

                <Label id="_IDGenLabel4"
                    text="{i18n>Matched}"
                    labelFor="shippedConsigneeBolMatchedFilter"/>

                <Select
                    id="shippedConsigneeBolMatchedFilter"
                    width="12rem"
                    selectedKey="all">

                    <core:Item id="_IDGenItem9"
                        key="all"
                        text="{i18n>filterAll}"/>

                    <core:Item id="_IDGenItem10"
                        key="matched"
                        text="{i18n>filterMatched}"/>

                    <core:Item id="_IDGenItem11"
                        key="unmatched"
                        text="{i18n>filterUnmatched}"/>

                </Select>

            </VBox>

            <Button
                id="shippedConsigneeBolFilterBtn"
                text="{i18n>filterButtonText}"
                icon="sap-icon://filter"
                press=".onShippedConsigneeBolFilter"/>

            <Button
                id="shippedConsigneeBolClearFilterBtn"
                text="{i18n>clearFilterButtonText}"
                icon="sap-icon://clear-filter"
                press=".onShippedConsigneeBolClearFilter"/>

        </HBox>

        <Table
            id="shippedConsigneeBolTable"
            inset="false"
            sticky="HeaderToolbar,ColumnHeaders"
            items="{
                path:'/ShippedConsigneeBOLCheck'
            }"
            width="auto">
            <headerToolbar>
                <Toolbar id="_IDGenToolbar2">
                    <Title id="_IDGenTitle2" text="Shipped BOL Check"/>
                    <ToolbarSpacer id="ToolbarSpacerShippedConsigneeBol"/>

                    <Button id="ToolbarSpacerShippedConsigneeBolbtn"
                        text="{i18n>aiAssistantButtonText}"
                        icon="sap-icon://ai"
                        type="Emphasized"
                        tooltip="{i18n>aiAssistantButtonTooltip}"
                        press=".onAIPress">
                        <customData>
                            <core:CustomData
                                key="tileKey"
                                value="shippedConsigneeBOLCheck"/>
                        </customData>
                    </Button>
                </Toolbar>
            </headerToolbar>
            <columns>
                <!-- PSA  -->
                <Column id="_IDGenColumn16">
                    <Text id="_IDGenText19" text="PSA BOL Number"/>
                </Column>
                <Column id="_IDGenColumn17">
                    <Text id="_IDGenText20" text="PSA Consignee Number"/>
                </Column>
                <!-- DIS  -->
                <Column id="_IDGenColumn18">
                    <Text id="_IDGenText21" text="DIS Bill of Lading"/>
                </Column>
                <Column id="_IDGenColumn19">
                    <Text id="_IDGenText22" text="DIS Customer Number"/>
                </Column>

                <!-- Matched Columns -->
                <Column id="_IDGenColumn20">
                    <Text id="_IDGenText23" text="Matched"/>
                </Column>
            </columns>
            <items>
                
            <ColumnListItem id="_IDGenColumnListItem1">
                <cells>
                    
                    <!-- PSA -->
                    <Text id="_IDGenText24" text="{PSABolNo}" />
                    <Text id="_IDGenText25" text="{PSAConsigneeNo}" />

                    <!-- DIS -->
                    <Text id="_IDGenText26" text="{DISBlading}" />
                    <Text id="_IDGenText27" text="{DISCustomer}" />

                    <!-- Matched -->
                        <ObjectStatus
                            id="_IDGenObjectStatus8"
                            text="{= %{Matched} === true ? 'Matched' : 'Unmatched' }"
                            state="{= %{Matched} === true ? 'Success' : 'Error' }"
                            icon="{= %{Matched} === true
                                ? 'sap-icon://accept'
                                : 'sap-icon://alert' }"/>
                </cells>
            </ColumnListItem>

            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
