
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Table
        id="shippedBolTable"
        inset="false"
        sticky="HeaderToolbar,ColumnHeaders"
        items="{
            path:'/ShippedBolCheck'
        }"
        width="auto">
        <headerToolbar>
            <Toolbar id="_IDGenToolbar1">
                <Title id="_IDGenTitle1" text="Shipped BOL Check"/>
                <ToolbarSpacer id="toolbarSpacerShippedBol"/>
                <Button id="aiShippedBolButton"
                    text="{i18n>aiAssistantButtonText}"
                    icon="sap-icon://ai"
                    type="Emphasized"
                    tooltip="{i18n>aiAssistantButtonTooltip}"
                    press=".onAIPress">
                    <customData>
                        <core:CustomData
                            key="tileKey"
                            value="shippedBolCheck"/>
                    </customData>
                </Button>
            </Toolbar>
        </headerToolbar>
        <columns>
            <!-- PSA  -->
            <Column id="_IDGenColumn5">
                <Text id="_IDGenText" text="{i18n>PSABolNumber}"/>
            </Column>
             <Column id="_IDGenColumn6">
                <Text id="_IDGenText1" text="{i18n>PSATotalUnits}"/>
            </Column>
             <Column id="_IDGenColumn7">
                <Text id="_IDGenText2" text="{i18n>PSATotalVolume}"/>
            </Column>
            <Column id="_IDGenColumn8">
                <Text id="_IDGenText3" text="{i18n>PSATotalBoxes}"/>
            </Column>
            <!-- DIS  -->
            <Column id="_IDGenColumn9">
                <Text id="_IDGenText4" text="{i18n>DISBlading}"/>
            </Column>
            <Column id="_IDGenColumn10">
                <Text id="_IDGenText5" text="{i18n>DISTotalUnits}"/>
            </Column>
             <Column id="_IDGenColumn11">
                <Text id="_IDGenText6" text="{i18n>DISTotalVolume}"/>
            </Column>
            <Column id="_IDGenColumn12">
                <Text id="_IDGenText7" text="{i18n>DISTotalBoxes}"/>
            </Column>

            <!-- Matched Columns -->
            <Column id="_IDGenColumn13">
                <Text id="_IDGenText8" text="{i18n>MatchedUnits}"/>
            </Column>
            <Column id="_IDGenColumn14">
                <Text id="_IDGenText9" text="{i18n>MatchedVolume}"/>
            </Column>
            <Column id="_IDGenColumn15">
                <Text id="_IDGenText10" text="{i18n>MatchedBoxes}"/>
            </Column>
        </columns>
        <items>
            
        <ColumnListItem id="_IDGenColumnListItem">
            <cells>
                
                <!-- PSA -->
                <Text id="_IDGenText11" text="{PSABolNo}" />
                <Text id="_IDGenText12" text="{PSATotalUnits}" />
                <Text id="_IDGenText13" text="{PSATotalVolume}" />
                <Text id="_IDGenText14" text="{PSATotalBoxes}" />

                <!-- DIS -->
                <Text id="_IDGenText15" text="{DISBlading}" />
                <Text id="_IDGenText16" text="{DISTotalUnits}" />
                <Text id="_IDGenText17" text="{DISTotalVolume}" />
                <Text id="_IDGenText18" text="{DISTotalBoxes}" />

                <!-- Matched Units -->
                    <ObjectStatus id="_IDGenObjectStatus"
                        text="{= ${MatchedUnits} === 'Yes' ? 'Matched' : 'Unmatched' }"
                        state="{= ${MatchedUnits} === 'Yes' ? 'Success' : 'Error' }"
                        icon="{= ${MatchedUnits} === 'Yes'
                            ? 'sap-icon://accept'
                            : 'sap-icon://alert' }"/>
                <!-- Matched Volume -->
                    <ObjectStatus id="_IDGenObjectStatus6"
                        text="{= ${MatchedVolume} === 'Yes' ? 'Matched' : 'Unmatched' }"
                        state="{= ${MatchedVolume} === 'Yes' ? 'Success' : 'Error' }"
                        icon="{= ${MatchedVolume} === 'Yes'
                            ? 'sap-icon://accept'
                            : 'sap-icon://alert' }"/>
                <!-- Matched Boxes -->
                    <ObjectStatus id="_IDGenObjectStatus7"
                        text="{= ${MatchedBoxes} === 'Yes' ? 'Matched' : 'Unmatched' }"
                        state="{= ${MatchedBoxes} === 'Yes' ? 'Success' : 'Error' }"
                        icon="{= ${MatchedBoxes} === 'Yes'
                            ? 'sap-icon://accept'
                            : 'sap-icon://alert' }"/>

            </cells>
        </ColumnListItem>

        </items>
    </Table>
</core:FragmentDefinition>
