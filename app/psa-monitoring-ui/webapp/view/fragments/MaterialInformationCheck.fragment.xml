
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox
        id="materialInformationWrapper"
        width="100%">

        <HBox
            id="materialInformationFilterBar"
            alignItems="End"
            wrap="Wrap"
            class="sapUiSmallMarginBottom">

            <VBox
                id="materialInformationMatchedFilterBox"
                class="sapUiSmallMarginEnd">

                <Label id="_IDGenLabel6"
                    text="{i18n>Matched}"
                    labelFor="materialInformationMatchedFilter"/>

                <Select
                    id="materialInformationMatchedFilter"
                    width="12rem"
                    selectedKey="all">

                    <core:Item id="_IDGenItem15"
                        key="all"
                        text="{i18n>filterAll}"/>

                    <core:Item id="_IDGenItem16"
                        key="matched"
                        text="{i18n>filterMatched}"/>

                    <core:Item id="_IDGenItem17"
                        key="unmatched"
                        text="{i18n>filterUnmatched}"/>

                </Select>

            </VBox>

            <Button
                id="materialInformationFilterBtn"
                text="{i18n>filterButtonText}"
                icon="sap-icon://filter"
                press=".onMaterialInformationFilter"/>

            <Button
                id="materialInformationClearFilterBtn"
                text="{i18n>clearFilterButtonText}"
                icon="sap-icon://clear-filter"
                press=".onMaterialInformationClearFilter"/>

        </HBox>

        <Table
            id="materialInformationCheckTable"
            inset="false"
            sticky="HeaderToolbar,ColumnHeaders"
            items="{
                path:'/MaterialInformationCheck'
            }"
            width="auto">
            <headerToolbar>
                <Toolbar id="materialInformationCheckToolbar">
                    <Title id="materialInformationCheckTitle" text="Material Information Check"/>
                    <ToolbarSpacer id="ToolbarSpacerMaterialInformationCheckBol"/>

                    <Button id="ToolbarSpacerMaterualInformationCheckbtn"
                        text="{i18n>aiAssistantButtonText}"
                        icon="sap-icon://ai"
                        type="Emphasized"
                        tooltip="{i18n>aiAssistantButtonTooltip}"
                        press=".onAIPress">
                        <customData>
                            <core:CustomData
                                key="tileKey"
                                value="materialInformationCheck"/>
                        </customData>
                    </Button>
                </Toolbar>
            </headerToolbar>
            <columns>
                <!-- PSA  -->
                <Column id="materialInformationCheckColumnPsaBolNumber">
                    <Text id="materialInformationCheckHeaderPsaBolNumberText" text="{i18n>PSABolNumber}"/>
                </Column>
                <Column id="materialInformationCheckColumnPsaPartNumber">
                    <Text id="materialInformationCheckHeaderPsaTotalUnitsText" text="{i18n>PSAMaterialDescription}"/>
                </Column>
                <!-- DIS  -->
                <Column id="materialInformationCheckColumnDisBlading">
                    <Text id="materialInformationCheckHeaderDisBolNumberText" text="{i18n>DISBoxNumber}"/>
                </Column>
                <Column id="materialInformationCheckColumnDisPartNumber">
                    <Text id="materialInformationCheckHeaderDisPartNumberText" text="{i18n>DISMaterialDescription}"/>
                </Column>

                <!-- Matched Columns -->
                <Column id="materialInformationCheckColumnMatched">
                    <Text id="materialInformationCheckHeaderMatchedText" text="{i18n>Matched}"/>
                </Column>
            </columns>
            <items>
                
            <ColumnListItem id="materialInformationCheckColumnListItem">
                <cells>
                    
                    <!-- PSA -->
                    <Text id="materialInformationCheckCellPsaBolNo" text="{PSABoxNumber}" />
                    <Text id="materialInformationCheckCellPsaPartNumber" text="{PSAMaterialDescription}" />

                    <!-- DIS -->
                    <Text id="materialInformationCheckCellDisBlading" text="{DISBoxNumber}" />
                    <Text id="materialInformationCheckCellDisPartNumber" text="{DISMaterialDesc}" />

                    <!-- Matched Units -->
                    <ObjectStatus
                        id="materialInformationCheckStatusMatchedUnits"
                        text="{= %{Matched} === true ? 'Matched' : 'Unmatched' }"
                        state="{= %{Matched} === true ? 'Success' : 'Error' }"
                        icon="{= %{Matched} === true
                            ? 'sap-icon://accept'
                            : 'sap-icon://alert' }"/>

                </cells>
            </ColumnListItem>

            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
