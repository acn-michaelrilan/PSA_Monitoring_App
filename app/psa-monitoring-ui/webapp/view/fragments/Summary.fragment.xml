<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox id="_IDGenVBox" class="sapUiMediumMargin">

        <GenericTile id="_IDGenGenericTile1"
            class="sapUiTinyMarginBegin sapUiTinyMarginTop"
            header="Available Boxes"
            subheader="Discrepancies"
            press=".onAvailableBoxesTilePress"
            state="{summary>/availableBoxCheck/tileState}">

            <TileContent id="_IDGenTileContent">
                <NumericContent id="_IDGenNumericContent"
                    scale="Box"
                    value="{summary>/availableBoxCheck/count}"
                    valueColor="{summary>/availableBoxCheck/valueColor}"
                    withMargin="false"
                    truncateValueTo="6" />
            </TileContent>

        </GenericTile>

    </VBox>

</core:FragmentDefinition>