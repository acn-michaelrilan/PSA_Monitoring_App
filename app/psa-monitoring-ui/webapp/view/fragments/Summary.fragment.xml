<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <HBox id="_IDGenHBox" wrap="Wrap" class="sapUiMediumMargin">

        <!-- Available Box Check -->
        <VBox id="_IDGenVBox" class="sapUiTinyMargin">
            <GenericTile id="_IDGenGenericTile1"
                header="Available Boxes"
                subheader="Discrepancies"
                press=".onAvailableBoxesTilePress"
                state="{summary>/availableBoxCheck/tileState}">

                <TileContent id="_IDGenTileContent">
                    <NumericContent id="_IDGenNumericContent"
                        scale="Box"
                        value="{summary>/availableBoxCheck/count}"
                        valueColor="{summary>/availableBoxCheck/valueColor}"
                        withMargin="false"
                        truncateValueTo="6" />
                </TileContent>

            </GenericTile>
        </VBox>


        <!-- Shipped BOL Check -->
        <VBox id="_IDGenVBox1" class="sapUiTinyMargin">
            <GenericTile id="_IDGenGenericTile2"
                header="Shipped BOL"
                subheader="Discrepancies"
                press=".onShippedBolTilePress"
                state="{summary>/shippedBolCheck/tileState}">

                <TileContent id="_IDGenTileContent1">
                    <NumericContent id="_IDGenNumericContent1"
                        scale="BOL"
                        value="{summary>/shippedBolCheck/count}"
                        valueColor="{summary>/shippedBolCheck/valueColor}"
                        withMargin="false"
                        truncateValueTo="6" />
                </TileContent>

            </GenericTile>
        </VBox>


        <!-- Shipped Consignee BOL Check -->
        <VBox id="_IDGenVBox2" class="sapUiTinyMargin">
            <GenericTile id="_IDGenGenericTile3"
                header="Consignee"
                subheader="BOL Mismatch"
                press=".onShippedConsigneeBolTilePress"
                state="{summary>/shippedConsigneeBOLCheck/tileState}">

                <TileContent id="_IDGenTileContent2">
                    <NumericContent id="_IDGenNumericContent2"
                        scale="BOL"
                        value="{summary>/shippedConsigneeBOLCheck/count}"
                        valueColor="{summary>/shippedConsigneeBOLCheck/valueColor}"
                        withMargin="false"
                        truncateValueTo="6" />
                </TileContent>

            </GenericTile>
        </VBox>


        <!-- Part Number BOL Check -->
        <VBox id="_IDGenVBox3" class="sapUiTinyMargin">
            <GenericTile id="_IDGenGenericTile4"
                header="Part Number"
                subheader="BOL Mismatch"
                press=".onPartNumberBolTilePress"
                state="{summary>/partNumberBOLCheck/tileState}">

                <TileContent id="_IDGenTileContent3">
                    <NumericContent id="_IDGenNumericContent3"
                        scale="Part"
                        value="{summary>/partNumberBOLCheck/count}"
                        valueColor="{summary>/partNumberBOLCheck/valueColor}"
                        withMargin="false"
                        truncateValueTo="6" />
                </TileContent>

            </GenericTile>
        </VBox>


        <!-- Material Information Check -->
        <VBox id="_IDGenVBox4" class="sapUiTinyMargin">
            <GenericTile id="_IDGenGenericTile5"
                header="Material Info"
                subheader="Mismatch"
                press=".onMaterialInformationTilePress"
                state="{summary>/materialInformationCheck/tileState}">

                <TileContent id="_IDGenTileContent4">
                    <NumericContent id="_IDGenNumericContent4"
                        scale="Box"
                        value="{summary>/materialInformationCheck/count}"
                        valueColor="{summary>/materialInformationCheck/valueColor}"
                        withMargin="false"
                        truncateValueTo="6" />
                </TileContent>

            </GenericTile>
        </VBox>

    </HBox>
