<mvc:View
    controllerName="psamonitoringui.controller.psa-monitoring-view"
    xmlns:mvc="sap.ui.core.mvc"
		xmlns="sap.m"
		xmlns:f="sap.f"
		xmlns:layout="sap.ui.layout"
        xmlns:core="sap.ui.core"
		height="100%">
    	
		<f:DynamicPage
			id="dynamicPageId"
			stickySubheaderProvider="iconTabBar"
			class="sapUiNoContentPadding">

			<!-- DynamicPage Title -->
			<f:title>
				<f:DynamicPageTitle>
					<f:heading>
						<Title text="PSA Monitoring Dashboard"/>
					</f:heading>
				</f:DynamicPageTitle>
			</f:title>
			<!-- DynamicPage Header -->
			<f:header>
				<!-- <f:DynamicPageHeader pinnable="true">
					<layout:HorizontalLayout allowWrapping="true">
						<layout:VerticalLayout class="sapUiMediumMarginEnd">
							<ObjectAttribute title="Location" text="Warehouse A"/>
							<ObjectAttribute title="Halway" text="23L"/>
							<ObjectAttribute title="Rack" text="34"/>
						</layout:VerticalLayout>

						<layout:VerticalLayout>
							<ObjectAttribute title="Availability"/>
							<ObjectStatus text="In Stock" state="Success" />
						</layout:VerticalLayout>
					</layout:HorizontalLayout>
				</f:DynamicPageHeader> -->
			</f:header>
			<f:content>
				
			<IconTabBar
				id="iconTabBar"
				selectedKey="summary"
				class="sapUiResponsiveContentPadding">

				<items>

					<IconTabFilter
						key="summary"
						text="Summary">

						<core:Fragment
							fragmentName="psamonitoringui.view.fragments.Summary"
							type="XML" />

					</IconTabFilter>

					<IconTabFilter
						key="availableBoxCheck"
						text="Available Box Check">

						<core:Fragment
							fragmentName="psamonitoringui.view.fragments.AvailableBoxCheckTable"
							type="XML" />

					</IconTabFilter>

					<IconTabFilter
						key="shippedBol"
						text="Shipped BOL">
						<Text text="Shipped BOL content goes here ..." />
					</IconTabFilter>

					<IconTabFilter
						key="shippedConsigneePerBol"
						text="Shipped Consignee per BOL">
						<Text text="Shipped Consignee per BOL content goes here ..." />
					</IconTabFilter>

					<IconTabFilter
						key="partNumberPerBolCheck"
						text="Part Number per BOL Check">
						<Text text="Part Number per BOL Check content goes here ..." />
					</IconTabFilter>

					<IconTabFilter
						key="materialInformationCheck"
						text="Material Information Check">
						<Text text="Material Information Check content goes here ..." />
					</IconTabFilter>

				</items>
			</IconTabBar>

			</f:content>
			<!-- DynamicPage Footer -->
			<f:footer>
				<OverflowToolbar>
					<ToolbarSpacer/>
					<Button type="Accept" text="Accept"/>
					<Button type="Reject" text="Reject"/>
				</OverflowToolbar>
			</f:footer>
		</f:DynamicPage>

</mvc:View>