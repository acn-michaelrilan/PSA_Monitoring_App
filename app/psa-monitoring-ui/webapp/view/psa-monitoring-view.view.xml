<mvc:View
    controllerName="psamonitoringui.controller.psa-monitoring-view"
    xmlns:mvc="sap.ui.core.mvc"
		xmlns="sap.m"
		xmlns:f="sap.f"
		xmlns:layout="sap.ui.layout"
        xmlns:core="sap.ui.core"
		height="100%">
    	
		<f:DynamicPage
			id="dynamicPageId"
			stickySubheaderProvider="iconTabBar"
			class="sapUiNoContentPadding">

			<!-- DynamicPage Title -->
			<f:title>
				<f:DynamicPageTitle id="_IDGenDynamicPageTitle1">
					<f:heading>
						<Title id="_IDGenTitle3" text="PSA Monitoring Dashboard"/>
					</f:heading>
				</f:DynamicPageTitle>
			</f:title>

			<f:content>
			<!-- DynamicPage Header -->			
			<IconTabBar
				id="iconTabBar"
				selectedKey="summary"
				class="sapUiResponsiveContentPadding">

				<items>

					<IconTabFilter id="_IDGenIconTabFilter"
						key="summary"
						text="Summary">

						<core:Fragment
							fragmentName="psamonitoringui/view.fragments.Summary"
							type="XML" />

					</IconTabFilter>

					<IconTabFilter id="_IDGenIconTabFilter1"
						key="availableBoxCheck"
						text="Available Box Check">

						<core:Fragment
							fragmentName="psamonitoringui.view.fragments.AvailableBoxCheckTable"
							type="XML" />

					</IconTabFilter>

					<IconTabFilter id="_IDGenIconTabFilter2"
						key="shippedBol"
						text="Shipped BOL">
						<core:Fragment
							fragmentName="psamonitoringui.view.fragments.ShippedBOLCheckTable"
							type="XML" />
					</IconTabFilter>

					<IconTabFilter id="_IDGenIconTabFilter3"
						key="shippedConsigneePerBol"
						text="Shipped Consignee per BOL">
						<core:Fragment
							fragmentName="psamonitoringui.view.fragments.ShippedConsigneeBOLTable"
							type="XML" />
					</IconTabFilter>

					<IconTabFilter id="_IDGenIconTabFilter4"
						key="partNumberPerBolCheck"
						text="Part Number per BOL Check">
						<core:Fragment
							fragmentName="psamonitoringui.view.fragments.PartNumberBOLCheckTable"
							type="XML" />
					</IconTabFilter>

					<IconTabFilter id="_IDGenIconTabFilter5"
						key="materialInformationCheck"
						text="Material Information Check">
						<core:Fragment
							fragmentName="psamonitoringui.view.fragments.MaterialInformationCheck"
							type="XML" />
					</IconTabFilter>

				</items>
			</IconTabBar>

			</f:content>
		</f:DynamicPage>

</mvc:View>