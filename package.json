{
  "name": "PSA_Monitoring_App",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.18.1",
    "node-fetch": "^2.7.0",
    "openai": "^6.45.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node --test",
    "watch-psa-monitoring-ui": "cds watch --open psamonitoringui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy PSA_Monitoring_App --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": "dummy",
      "[production]": {
        "db": "hana",
        "auth": "dummy"
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
